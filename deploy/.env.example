# 复制本文件为 .env 并填入实际值：cp .env.example .env
# 用于 docker-compose 的变量注入（docker compose 会自动读取同目录 .env）

# ===== PostgreSQL =====
POSTGRES_USER=park
POSTGRES_PASSWORD=<your-strong-db-password>
POSTGRES_DB=smart_park

# ===== Redis =====
# 生产环境必须设置强密码，compose 会以此启动 Redis 并注入到后端连接串
REDIS_PASSWORD=<your-strong-redis-password>

# ===== 后端 JWT（需与 backend/.env 中 SECRET_KEY 保持一致）=====
SECRET_KEY=<your-strong-secret-key-at-least-32-chars>

# ===== 初始化管理员密码（仅首次执行 init_data.py 时使用）=====
ADMIN_PASSWORD=<your-admin-password>
