# 复制本文件为 .env 并填入实际值：cp .env.example .env
# 严禁将 .env 提交到版本库

# 应用（生产环境设为 false）
DEBUG=true

# 数据库 —— 必须填写
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/smart_park

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT —— 必须填写强密钥（至少 32 字符）
SECRET_KEY=<your-strong-secret-key-at-least-32-chars>
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS —— 生产环境改为实际域名，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI 服务
AI_SERVICE_URL=http://localhost:8001
